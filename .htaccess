# HVAC PROF | Configuracion de produccion desarrollada por Estudio Ideamos.

Options -Indexes
ServerSignature Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Private and development paths never belong to the public site.
  RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
  RewriteRule ^(?:tools|node_modules|repositories)(?:/|$) - [F,L,NC]
  # The contact handler is the only public executable endpoint.
  RewriteRule ^(?!enviar-contacto\.php$).*\.php(?:/|$) - [F,L,NC]
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|POST)$
  RewriteRule ^ - [R=405,L]
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ https://hvacprof.com.ar/ [R=301,L]

  # Una sola version publica: HTTPS sin www.
  RewriteCond %{HTTP_HOST} ^www\.hvacprof\.com\.ar$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://hvacprof.com.ar%{REQUEST_URI} [R=301,L]

  # Conserva las principales URL de la web anterior.
  RewriteRule ^nosotros/?$ /nosotros.html [R=301,L,NC]
  RewriteRule ^productos-y-servicios/?$ /productos.html [R=301,L,NC]
  RewriteRule ^fabricacion-de-conductos/?$ /productos.html [R=301,L,NC]
  RewriteRule ^montaje-de-conductos/?$ /servicios.html [R=301,L,NC]
  RewriteRule ^trabajos-realizados/?$ /proyectos.html [R=301,L,NC]
  RewriteRule ^contacto/?$ /contacto.html [R=301,L,NC]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-BWZM1Y3taGq5xiYdhDuE3lgKtGc1pWe5H9lY6F6KOgI=' 'sha256-TpWRvkoonTXcrSyUnhyqJoKdmKNjkhJDpIljpkSgRc0=' 'sha256-FqXEFG+CPxPeE5fXmTcb48UAcU1A67goA5CrYeQMN04=' 'sha256-faoWAfR5bPWzh/rDOPehpT02g1ozO6lsuao4xexYGyY=' 'sha256-iXIxPDBaAe7rnixkX8BdB7jjpyVJhQpSgN2Zxbiz+70=' 'sha256-js++O4ve/Ylw2L6hwULI9/CX3QvALvxbXR3dX2FRKuc=' 'sha256-GoGH4QvX/n1B/jAcp6LSVRTSHPODRVG7/jifsYsWd64=' 'sha256-jxNXFmPgySXHPu/eaXVSAd1uHpi2mo+/OsdwSXA0AAY=' 'sha256-tT/E82tQ3MkdnN9UKEZeloqtNvtXpQ94CipYoWGz2Cg=' 'sha256-tfFdPqaAtycZLrrl38UE5AfNJMDNf7EOLaA7zvsdvkg=' 'sha256-+4EnQvl3GpSVvD/3UsOMbfPldlnLQaOfTfFzBH6dXmU=' 'sha256-Os6t2cpvb0mds1eLcIf8X7JPjDdGaQbC2F0/lwHtX7M=' 'sha256-tXTSPtQdrzl3B9k7P3ew5zM0i27Xx3oWlfmvHYkVmrg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src 'none'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always unset X-Powered-By

  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header always set Cache-Control "no-store, max-age=0"
  </FilesMatch>

  <FilesMatch "^(?:llms\.txt|robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "^site\.[a-f0-9]{12}\.(?:css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^(?:404\.html|enviar-contacto\.php)$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  <FilesMatch "\.(?:png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<FilesMatch "(?i)(^\.|\.(?:bak|old|orig|swp|config|dist|env|ini|log|md|sql|wpress|zip|tar|gz|7z|rar|pem|key|p12|pfx|mjs|ps1|map)$|~$|package(?:-lock)?\.json$)">
  Require all denied
</FilesMatch>

LimitRequestBody 32768
AddType font/woff2 .woff2
AddType image/webp .webp
